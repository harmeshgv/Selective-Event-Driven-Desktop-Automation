# --- Backend ---
BACKEND_PORT=8000

# Use Postgres in production; switch to SQLite for local MVP if desired:
# DATABASE_URL=sqlite:///./dev.db
DATABASE_URL=postgresql+psycopg2://flowpilot:flowpilot@localhost:5432/flowpilot

# CORS for local dev / Tauri dev builds
CORS_ORIGINS=*

# --- Task Explainer / LLM ---
# Use `heuristic` for local fallback behavior or `groq` for Groq's OpenAI-compatible API.
TASK_EXPLAINER_PROVIDER=heuristic
TASK_EXPLAINER_ENDPOINT=
TASK_EXPLAINER_API_KEY=
TASK_EXPLAINER_MODEL=

# --- Automation Engine ---
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# --- Automation LLM (falls back to TASK_EXPLAINER_* if not set) ---
# AUTOMATION_LLM_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
# AUTOMATION_LLM_API_KEY=
# AUTOMATION_LLM_MODEL=

# --- Observer ---
OBSERVER_BACKEND_URL=http://localhost:8000
OBSERVER_LOG_ENDPOINT=/logs

# Where screenshots are stored locally
SCREENSHOT_DIR=./screenshots
SCREENSHOT_EVERY_SECONDS=30

# Cap mouse-move event rate (events/sec). Set to 0 to disable move capture completely.
MOUSE_MOVE_HZ=2

# Keep event hooks responsive even if the backend is slow.
OBSERVER_MAX_PENDING_LOGS=512

# Cache active-window lookups briefly to reduce per-event overhead.
WINDOW_TITLE_CACHE_MS=250

# When true, the observer will mask typed text unless you configure sensitive keywords.
MASK_TEXT_BY_DEFAULT=true

# Comma-separated keywords; if the active window title contains any of these,
# typed text is masked.
SENSITIVE_WINDOW_KEYWORDS=password,pass,credential

# Optional: restrict capturing to a whitelist of window title keywords (empty => all windows)
CAPTURE_WINDOW_TITLE_KEYWORDS=

# Observer runtime settings (frontend controls these without restarting)
OBSERVER_SETTINGS_ENDPOINT=/observer/settings
OBSERVER_SETTINGS_POLL_SECONDS=5

# Initial screenshot capture enablement (frontend can toggle later)
SCREENSHOTS_ENABLED=false


