<Page x:Class="SEDA.Wpf.Pages.SessionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="SessionPage">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Session" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Start collection, stop to finalize a session, or clear local data." Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,18,0,0">
            <Button Style="{StaticResource PrimaryButton}" Click="Start_OnClick" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE768;" Margin="0,0,8,0"/>
                    <TextBlock Text="Start Session"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource PrimaryButton}" Click="Stop_OnClick" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE71A;" Margin="0,0,8,0"/>
                    <TextBlock Text="Stop Session"/>
                </StackPanel>
            </Button>
            <Button Click="Refresh_OnClick" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" Margin="0,0,8,0"/>
                    <TextBlock Text="Refresh Status"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource DangerButton}" Click="Clear_OnClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" Margin="0,0,8,0"/>
                    <TextBlock Text="Clear Data"/>
                </StackPanel>
            </Button>
        </WrapPanel>

        <Border Grid.Row="2" Margin="0,18,0,0" Background="{StaticResource AppBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
            <StackPanel>
                <TextBlock Text="Collector status" FontWeight="SemiBold" />
                <TextBlock Text="{Binding StatusLine}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding DetailsLine}" Margin="0,10,0,0"/>
                <TextBlock Text="{Binding ErrorLine}" Foreground="#FFFCA5A5" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>

