<Window x:Class="SEDA.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SEDA" Width="1200" Height="720" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResizeWithGrip">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" CornerRadius="10" GlassFrameThickness="0" ResizeBorderThickness="6"/>
    </shell:WindowChrome.WindowChrome>

    <Border Margin="10" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Background="{StaticResource AppBg}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Shell title bar -->
            <Grid Grid.Row="0" Height="44" Margin="16,12,16,8" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="SEDA" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1" Text="{Binding HeaderTitle}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="14,0,0,0"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Padding="10,4" CornerRadius="12" Background="#FF064E3B" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusTextBlock" Text="{Binding StatusText}" Foreground="#FFBBF7D0" FontWeight="SemiBold"/>
                    </Border>

                    <Button Width="44" Height="30" Padding="0" Margin="0,0,6,0" Click="Minimize_OnClick" ToolTip="Minimize">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE921;" FontSize="12" HorizontalAlignment="Center"/>
                    </Button>
                    <Button Width="44" Height="30" Padding="0" Margin="0,0,6,0" Click="Maximize_OnClick" ToolTip="Maximize">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE922;" FontSize="12" HorizontalAlignment="Center"/>
                    </Button>
                    <Button Width="44" Height="30" Padding="0" Click="Close_OnClick" ToolTip="Close" Style="{StaticResource DangerButton}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8BB;" FontSize="12" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Shell body -->
            <Grid Grid.Row="1" Margin="16,0,16,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Nav -->
                <Border Grid.Column="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8">
                    <StackPanel>
                        <TextBlock Text="Navigation" Style="{StaticResource MutedText}" Margin="8,6,8,10"/>
                        <ListBox x:Name="NavList" SelectionChanged="NavList_OnSelectionChanged">
                            <ListBoxItem IsSelected="True">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE80F;" Margin="0,0,10,0"/>
                                    <TextBlock Text="Session"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8D4;" Margin="0,0,10,0"/>
                                    <TextBlock Text="Repeated Tasks"/>
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" Margin="0,0,10,0"/>
                                    <TextBlock Text="Bundle Details"/>
                                </StackPanel>
                            </ListBoxItem>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Page host -->
                <Border Grid.Column="1" Margin="12,0,0,0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                    <Frame x:Name="RootFrame" NavigationUIVisibility="Hidden"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>

