<Page x:Class="SEDA.Wpf.Pages.BundleDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="BundleDetailsPage">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Bundle Details" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="Inspect actions inside a selected bundle." Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,18,0,0">
            <Button Style="{StaticResource PrimaryButton}" Click="Load_OnClick" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" Margin="0,0,8,0"/>
                    <TextBlock Text="Load bundles"/>
                </StackPanel>
            </Button>
            <TextBlock Text="Min repeats" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
            <TextBox Text="{Binding MinRepeats}" Width="60" Margin="10,0,18,0"/>
        </WrapPanel>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock DockPanel.Dock="Top" Text="Bundles" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ListBox ItemsSource="{Binding Bundles}" SelectionChanged="Bundles_OnSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <DockPanel Grid.Column="1" Margin="0,0,12,0">
                <TextBlock DockPanel.Dock="Top" Text="Actions" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ListBox ItemsSource="{Binding Actions}" SelectionChanged="Actions_OnSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <Border Grid.Column="2" Background="{StaticResource AppBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                <StackPanel>
                    <TextBlock Text="{Binding ActionHeader}" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ActionSubheader}" Style="{StaticResource MutedText}" Margin="0,6,0,0"/>
                    <TextBox Text="{Binding ActionRawJson}" IsReadOnly="True" Margin="0,12,0,0"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                    <TextBlock Text="{Binding ErrorLine}" Foreground="#FFFCA5A5" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>

