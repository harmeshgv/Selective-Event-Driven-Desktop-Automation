# ===== SEDA LLM Settings =====
# Choose: disabled | groq | ollama
SEDA_LLM_PROVIDER=groq

# Provider model (examples)
# Groq: llama-3.1-8b-instant
# Ollama: llama3.1:8b
SEDA_LLM_MODEL=llama-3.1-8b-instant

# Required for Groq provider
SEDA_GROQ_API_KEY=replace_with_your_groq_api_key

# Optional overrides
# SEDA_LLM_BASE_URL=https://api.groq.com/openai/v1
SEDA_LLM_TIMEOUT_SECONDS=30
SEDA_AUTOMATION_MIN_STEPS=15

# Optional existing settings
# SEDA_MCP_PORT=9315
# SEDA_DEBUG=1
